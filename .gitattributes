# Normalize line endings in the repo; checkout follows platform defaults.
* text=auto

# Source and config files
*.cs text diff=csharp
*.xaml text
*.csproj text
*.props text
*.targets text
*.sln text eol=crlf
*.json text
*.yml text
*.yaml text
*.md text
*.txt text
*.ps1 text
*.admx text
*.adml text

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.onnx binary
*.pdf binary

# Icon assets
*.svg text
*.ico binary

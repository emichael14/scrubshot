<Project Sdk="Microsoft.NET.Sdk">

  <!--
    ScrubShot.Capture: monitor enumeration, screen capture, frozen screen, selection overlay.
    Win32 only through CsWin32 (NativeMethods.txt). No WinUI. See docs/architecture.md.
  -->
  <PropertyGroup>
    <RootNamespace>ScrubShot.Capture</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.CsWin32" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ScrubShot.Core\ScrubShot.Core.csproj" />
  </ItemGroup>

</Project>

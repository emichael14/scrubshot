<UserControl
    x:Class="ScrubShot.App.Settings.SettingCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ScrubShot.App.Settings"
    IsTabStop="False">

    <!-- One setting: name and notes on the left, a lock when policy sets it, the control on the right. -->
    <Grid
        MinHeight="64"
        Padding="16,10"
        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1"
        ColumnSpacing="16"
        CornerRadius="{ThemeResource ControlCornerRadius}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel VerticalAlignment="Center" Spacing="2">
            <TextBlock Text="{x:Bind Header, Mode=OneWay}" TextWrapping="Wrap" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{ThemeResource CaptionTextBlockStyle}"
                Text="{x:Bind Description, Mode=OneWay}"
                TextWrapping="Wrap"
                Visibility="{x:Bind local:SettingCard.VisibleWhenNotEmpty(Description), Mode=OneWay}" />
            <TextBlock
                x:Name="ErrorText"
                AutomationProperties.LiveSetting="Polite"
                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                Style="{ThemeResource CaptionTextBlockStyle}"
                Text="{x:Bind Error, Mode=OneWay}"
                TextWrapping="Wrap"
                Visibility="{x:Bind local:SettingCard.VisibleWhenNotEmpty(Error), Mode=OneWay}" />
        </StackPanel>

        <FontIcon
            Grid.Column="1"
            VerticalAlignment="Center"
            AutomationProperties.Name="Managed by your organization"
            FontSize="16"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Glyph="&#xE72E;"
            ToolTipService.ToolTip="Managed by your organization"
            Visibility="{x:Bind IsLocked, Mode=OneWay}" />

        <ContentControl
            Grid.Column="2"
            VerticalAlignment="Center"
            HorizontalContentAlignment="Right"
            Content="{x:Bind ActionContent, Mode=OneWay}"
            IsEnabled="{x:Bind local:SettingCard.Not(IsLocked), Mode=OneWay}"
            IsTabStop="False" />
    </Grid>
</UserControl>
